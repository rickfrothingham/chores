{
  // Cloudflare reads this file on every deploy.
  "name": "chores",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  // /public holds only the icons and the drag-and-drop library. The page itself
  // (src/page.html) is served by the Worker, and only at the secret /k/<APP_KEY>/ address.
  "assets": { "directory": "./public" },

  // APP_KEY is NOT set here: it's a secret, set in the Cloudflare dashboard
  // (Worker → Settings → Variables and Secrets, type "Secret"). See the README.

  // The database. No ID needed: Cloudflare creates it on the first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "chores" }],

  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },

  "vars": {
    // Decides when a day starts, for due dates and recurring tasks.
    "TIMEZONE": "America/New_York"
  }
}
